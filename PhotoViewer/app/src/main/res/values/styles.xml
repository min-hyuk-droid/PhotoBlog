<resources>
    <!-- 크림 + 노랑 테마 (앱 아이콘 색감, 밝은 배경) -->
    <style name="AppTheme.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_yellow</item>
        <item name="colorOnPrimary">@color/brand_black</item>
        <item name="colorPrimaryContainer">@color/yellow_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_black</item>
        <item name="colorSecondary">@color/brand_yellow</item>
        <item name="colorOnSecondary">@color/brand_black</item>
        <item name="colorSecondaryContainer">@color/yellow_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="colorControlActivated">@color/brand_yellow</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- 글꼴: Jua (Google Fonts, OFL) - 일반 글자와 Material 버튼·입력칸 모두 -->
        <item name="android:fontFamily">@font/jua</item>
        <item name="fontFamily">@font/jua</item>
        <item name="android:textAppearanceButton">@style/AppTheme.TextButton</item>
        <item name="textAppearanceLabelLarge">@style/AppTheme.TextButton</item>
        <item name="textAppearanceBodyLarge">@style/AppTheme.TextBody</item>
        <item name="textAppearanceBodyMedium">@style/AppTheme.TextBody</item>
        <item name="textAppearanceTitleMedium">@style/AppTheme.TextBody</item>
        <item name="textAppearanceTitleLarge">@style/AppTheme.TextBody</item>
        <item name="textAppearanceHeadlineSmall">@style/AppTheme.TextBody</item>
        <item name="alertDialogTheme">@style/AppTheme.Dialog</item>
        <item name="android:spinnerDropDownItemStyle">@style/AppTheme.SpinnerItem</item>
        <item name="android:dropDownListViewStyle">@style/AppTheme.DropDown</item>
    </style>

    <!-- 대화상자(게시·상세보기·삭제 확인): 흰 둥근 카드 + 노란 강조 -->
    <style name="AppTheme.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorAccent">@color/accent_text</item>
        <item name="colorPrimary">@color/accent_text</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/brand_yellow</item>
        <item name="android:fontFamily">@font/jua</item>
        <item name="fontFamily">@font/jua</item>
        <item name="android:textAppearanceButton">@style/AppTheme.TextButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppTheme.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppTheme.DialogButton</item>
    </style>

    <!-- 대화상자 아래 [취소]/[게시]/[닫기] 글자: 진한 노랑 -->
    <style name="AppTheme.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:fontFamily">@font/jua</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppTheme.TextButton" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/jua</item>
        <item name="fontFamily">@font/jua</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppTheme.TextBody" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/jua</item>
        <item name="fontFamily">@font/jua</item>
    </style>

    <!-- 서버 선택 드롭다운 -->
    <style name="AppTheme.DropDown" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:background">@color/surface_variant</item>
    </style>

    <style name="AppTheme.SpinnerItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/jua</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base" />
</resources>
