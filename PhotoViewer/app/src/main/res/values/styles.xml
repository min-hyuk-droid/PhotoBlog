<resources>
    <!-- 검정 + 노랑 테마 (앱 아이콘 색감) -->
    <style name="AppTheme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_yellow</item>
        <item name="colorOnPrimary">@color/brand_black</item>
        <item name="colorPrimaryContainer">@color/yellow_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_yellow</item>
        <item name="colorSecondary">@color/brand_yellow</item>
        <item name="colorOnSecondary">@color/brand_black</item>
        <item name="colorSecondaryContainer">@color/yellow_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_yellow</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/brand_black</item>
        <item name="android:windowBackground">@color/brand_black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="colorControlActivated">@color/brand_yellow</item>
        <item name="android:statusBarColor">@color/brand_black</item>
        <item name="android:navigationBarColor">@color/brand_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="alertDialogTheme">@style/AppTheme.Dialog</item>
        <item name="android:spinnerDropDownItemStyle">@style/AppTheme.SpinnerItem</item>
        <item name="android:dropDownListViewStyle">@style/AppTheme.DropDown</item>
    </style>

    <!-- 대화상자(게시·상세보기·삭제 확인): 어두운 둥근 카드 + 노란 버튼 -->
    <style name="AppTheme.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorAccent">@color/brand_yellow</item>
        <item name="colorPrimary">@color/brand_yellow</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/brand_yellow</item>
    </style>

    <!-- 서버 선택 드롭다운 -->
    <style name="AppTheme.DropDown" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:background">@color/surface_variant</item>
    </style>

    <style name="AppTheme.SpinnerItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base" />
</resources>
