# secrets.properties.example → secrets.properties 로 복사한 뒤 값을 채운다 (secrets.properties 는 git 에 올리지 않음)
# 토큰 발급: 서버 폴더에서  python manage.py drf_create_token <username>

# 로컬 서버 (에뮬레이터에서 PC 의 127.0.0.1 = 10.0.2.2)
LOCAL_URL=http://10.0.2.2:8000
LOCAL_TOKEN=

# PythonAnywhere 클라우드 서버
REMOTE_URL=https://smh0927.pythonanywhere.com
REMOTE_TOKEN=
